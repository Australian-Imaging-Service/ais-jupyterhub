# JupyterHub Secrets Template
# =========================
# This is a TEMPLATE file for creating your own secrets.
# DO NOT commit this file with real secrets!! This is NOT a installation file!!
#
# Instructions:
# 1. Run: ./sops-setup.sh (to generate your encryption key)
# 2. Copy this file: cp 5-jupyterhub-secrets.yaml.template 5-jupyterhub-secrets.yaml
# 3. Edit with your values: ./sops-helper.sh edit
# 4. The file will be automatically encrypted when you save
#
# Or simply run: ./sops-helper.sh generate (to auto-generate random values) and then edit using ./sops-helper.sh edit with your values and save to encrypt

hub:
  config:
    GenericOAuthenticator:
      # Get from your OAuth2 provider (AAF, Google, GitHub, etc.)
      client_id: "YOUR_OAUTH_CLIENT_ID_HERE"
      client_secret: "YOUR_OAUTH_CLIENT_SECRET_HERE"

  services:
    xnat-service:
      # Generate with: openssl rand -hex 32
      apiToken: "YOUR_JUPYTERHUB_SERVICE_TOKEN_HERE"

  extraEnv:
    # Generate with: openssl rand -hex 32
    JUPYTERHUB_CRYPT_KEY_HEX: "YOUR_CRYPT_KEY_HEX_HERE"

    # Your XNAT admin password
    XNAT_PASSWORD: "YOUR_XNAT_ADMIN_PASSWORD_HERE"
